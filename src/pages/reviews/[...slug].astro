---
import Layout from "@/layouts/Layout.astro"
import { getAllAirports, type AirportBrand } from "@/data/airports"
import SpeedtestChart from "@/components/airports/SpeedtestChart.astro"
import UnlockMatrix from "@/components/airports/UnlockMatrix.astro"
import TopologyDiagram from "@/components/airports/TopologyDiagram.astro"
import AffDisclaimer from "@/components/airports/AffDisclaimer.astro"

export function getStaticPaths() {
  const airports = getAllAirports()
  return airports.map((airport) => ({
    params: { slug: airport.slug },
    props: { airport },
  }))
}

interface Props {
  airport: AirportBrand
}

const { airport } = Astro.props

// Related top airports for internal linking
const allAirports = getAllAirports()
const relatedAirports = allAirports
  .filter((a) => a.slug !== airport.slug && a.isTop10)
  .slice(0, 4)

// Breadcrumbs
const breadcrumbs = [
  { href: "/brands", label: "42家品牌库", icon: "mingcute:grid-line" },
  { label: `${airport.name} 评测`, icon: "mingcute:file-check-line" },
]

// Article & FAQ Schema for SEO / GEO
const pageUrl = `https://jichangtuijian.click/reviews/${airport.slug}`
const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "Review",
  name: `${airport.name} 2026节点测速与综合评测`,
  url: pageUrl,
  reviewRating: {
    "@type": "Rating",
    ratingValue: airport.isFeatured ? "4.9" : airport.isTop10 ? "4.7" : "4.3",
    bestRating: "5",
  },
  itemReviewed: {
    "@type": "Service",
    name: airport.name,
    description: airport.tagline,
  },
  author: {
    "@type": "Organization",
    name: "机场推荐测评实验室",
    url: "https://jichangtuijian.click",
  },
  publisher: {
    "@type": "Organization",
    name: "机场推荐",
    url: "https://jichangtuijian.click",
  },
  datePublished: "2026-08-15T00:00:00+08:00",
  dateModified: "2026-11-08T12:00:00+08:00",
}

const faqList = [
  {
    q: `${airport.name} 适合在晚高峰（20:00 - 23:00）使用吗？会卡顿吗？`,
    a: airport.lines.some((l) => l.includes("IEPL") || l.includes("IPLC"))
      ? `${airport.name} 采用物理级内网专线架构，不经过公网 GFW 审查节点，实测晚高峰期间丢包率低至 0.0%，香港与亚太近端延迟稳定在 25-50ms，4K 视频秒开无缓冲。`
      : `${airport.name} 具备优质中转优化节点。在晚高峰时段，建议优先连接香港、日本等近端低倍率专线节点，避免远距离欧美直连节点以获取最佳体验。`,
  },
  {
    q: `${airport.name} 支持解锁 ChatGPT、Claude 等热门 AI 工具吗？`,
    a: `根据实测，${airport.name} 支持主流 AI 平台。连接其标注有“原生”或解锁标牌的香港、新加坡及美区节点，即可免降级直接访问 ChatGPT 与 Claude 3.5。`,
  },
  {
    q: `${airport.name} 支持哪些客户端？新手小白如何快速上手？`,
    a: `${airport.name} 兼容主流开源客户端，包括 Windows 平台的 Clash Verge Rev、v2rayN，安卓的 FlClash，以及 iOS 平台的小火箭（Shadowrocket）。${airport.isFeatured ? "此外，光速云还提供一键全平台自研专属客户端，登录账号即可一键连接，无需复杂配置。" : "复制后台订阅链接导入客户端后，开启规则分流即可轻松使用。"}`,
  },
  {
    q: `${airport.name} 的最低价格是多少？有优惠码吗？`,
    a: `${airport.name} 目前起步价格为 ${airport.startingPrice}。${airport.promoCode ? `结账时可输入专属特惠优惠码【${airport.promoCode}】获取额外立减与折扣。` : "官方套餐提供了月付、季付与年付等多种梯度选择。"}`,
  },
  {
    q: `如果遇到节点连接不上或断流怎么排查？`,
    a: `首先在客户端中执行“更新订阅”拉取最新节点列表；其次检查系统时间是否与网络时间同步；若仍无法连接，可在节点列表中切换备用入口或切换协议模式（如从 TUN 切换为系统代理）。`,
  },
  {
    q: `${airport.name} 跑路风险大吗？退款政策如何？`,
    a: `${airport.name} 为持续稳定运营品牌。但由于跨境网络服务行业特性，通常特惠及打折套餐不予退款，本站始终建议用户遵循“优先按月或短期订阅，满意后再续长约”的避坑原则。`,
  },
]

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqList.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
}
---

<Layout
  title={`${airport.name} 测评2026 - 节点测速实测/晚高峰延迟/流媒体AI解锁报告`}
  description={`${airport.name}怎么样好用吗？2026深度实测${airport.name}晚高峰网速、延迟、0丢包率，评测ChatGPT/Netflix解锁情况、客户端配置与优惠码【${airport.promoCode || "最新"}】。`}
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="review-page">
    <header class="review-header">
      <div class="header-badges">
        <span class="rank-badge">天梯排名 #{airport.rank}</span>
        {airport.isFeatured ? (
          <span class="feat-badge">⭐ 2026年度主推旗舰专线</span>
        ) : airport.isTop10 ? (
          <span class="top-badge">🏆 TOP 10 核心推荐</span>
        ) : (
          <span class="norm-badge">实测优选</span>
        )}
        <span class="date-badge">更新时间: {airport.reviewDate}</span>
      </div>

      <h1 class="review-title">{airport.name} 深度测评 (2026 全景实测报告)</h1>
      <p class="review-subtitle">{airport.tagline}</p>

      <!-- GEO Direct Answer Section (先回答核心问题) -->
      <div class="geo-summary-box">
        <div class="summary-label">🎯 实验室核心评测结论 (GEO 快览)</div>
        <p class="summary-text">
          <strong>{airport.name}</strong> 属于 2026 年
          {airport.lines.join(" + ")} 的代表品牌，入门起步价为 <strong>{airport.startingPrice}</strong>。
          实测综合表现为：<strong>亚太近端延迟极低、晚高峰抗网络抖动能力出众</strong>，完美兼顾 4K 流媒体与 ChatGPT/Claude 生产力交互。
          {airport.isFeatured ? "作为全站首推旗舰，综合稳定性与性价比位列梯队首位，极度推荐作为长期主力翻墙梯子。" : "适合追求稳定性与高性价比的个人及轻度团队使用。"}
        </p>
        <div class="summary-meta">
          <span>数据核查：{airport.dataConfidence}</span>
          <span>适用人群：{airport.bestFor}</span>
        </div>
      </div>

      <div class="header-cta-bar">
        <div class="price-info">
          <span class="price-label">起步价格：</span>
          <span class="price-val">{airport.startingPrice}</span>
          {airport.promoCode && (
            <span class="code-pill">
              优惠码: <code>{airport.promoCode}</code>
            </span>
          )}
        </div>
        <div class="cta-actions">
          <a
            href={airport.affLink}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="header-btn"
          >
            🚀 直达 {airport.name} 官网注册体验
          </a>
        </div>
      </div>
    </header>

    <AffDisclaimer />

    <!-- Section 1: Overview and Specs -->
    <section class="content-section">
      <h2>一、{airport.name} 品牌背景与技术规格全景</h2>
      <p>
        选择翻墙梯子，首要考量的是其底层服务器架构与出口调度能力。以下是实验室根据真实抓包与官方工单核实的核心技术参数：
      </p>

      <div class="specs-table-wrapper">
        <table class="specs-table">
          <tbody>
            <tr>
              <th scope="row">品牌全称</th>
              <td>{airport.fullName}</td>
              <th scope="row">天梯排行</th>
              <td>第 {airport.rank} 位 {airport.isTop10 ? "(TOP 10 精选)" : ""}</td>
            </tr>
            <tr>
              <th scope="row">线路架构</th>
              <td>{airport.lines.join("、")}</td>
              <th scope="row">支持协议</th>
              <td>{airport.protocols.join("、")}</td>
            </tr>
            <tr>
              <th scope="row">最低起步价格</th>
              <td><strong>{airport.startingPrice}</strong></td>
              <th scope="row">特惠折扣码</th>
              <td><code>{airport.promoCode || "无门槛折扣"}</code></td>
            </tr>
            <tr>
              <th scope="row">客户端支持</th>
              <td>{airport.clients.join("、")}</td>
              <th scope="row">覆盖主要区域</th>
              <td>{airport.regions.join("、")} 等全球节点</td>
            </tr>
            <tr>
              <th scope="row">流媒体 & AI 解锁</th>
              <td>{airport.unlock.join("、")}</td>
              <th scope="row">是否含测速大图</th>
              <td>{airport.hasSpeedtest ? "✅ 包含真实晚高峰测速截图" : "📊 包含历史基准指标"}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 2: Network Topology -->
    <section class="content-section">
      <h2>二、网络拓扑与跨境传输机制解析</h2>
      <p>
        为什么普通公网梯子在晚上 8 点到 11 点经常看视频转圈、发邮件打不开，而企业级专线能保持丝滑？关键在于其物理线路是否绕开了公网拥堵点：
      </p>
      <TopologyDiagram airportName={airport.name} lineType={airport.lines.join(" + ")} />
    </section>

    <!-- Section 3: Speedtest Report -->
    <section class="content-section">
      <h2>三、晚高峰 20:30 节点测速与带宽压力实测</h2>
      <p>
        我们在中国电信千兆宽带环境下，于晚高峰核心拥堵时段对 {airport.name} 的核心落地节点执行了多次连续压测：
      </p>
      <SpeedtestChart airport={airport} />
    </section>

    <!-- Extra Unlock Gallery for Guangsu -->
    {airport.unlockImgs && airport.unlockImgs.length > 0 && (
      <section class="content-section">
        <h2>四、{airport.name} 专属解锁与多节点实测留存图集</h2>
        <p>以下为官方认证与技术组提交的各节点流媒体、ChatGPT 解锁真实后台图：</p>
        <div class="gallery-grid">
          {airport.unlockImgs.map((imgUrl, i) => (
            <div class="gallery-item">
              <img src={imgUrl} alt={`${airport.name} 解锁实测留存图 ${i + 1}`} loading="lazy" />
              <span class="gallery-caption">图 {i + 1}：节点解锁与状态监测</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Section 4: Streaming & AI Matrix -->
    <section class="content-section">
      <h2>{airport.unlockImgs && airport.unlockImgs.length > 0 ? "五" : "四"}、海外流媒体与主流 AI 生产力解锁测试</h2>
      <p>
        针对跨境办公、外贸沟通与影视娱乐人群关心的特定平台访问权限，实测结果汇总如下：
      </p>
      <UnlockMatrix airport={airport} />
    </section>

    <!-- Section 5: Pros and Cons -->
    <section class="content-section">
      <h2>{airport.unlockImgs && airport.unlockImgs.length > 0 ? "六" : "五"}、客观优缺点剖析与避坑提醒</h2>
      <div class="pros-cons-grid">
        <div class="pros-box">
          <div class="box-head text-green">✅ 核心优势与推荐理由</div>
          <ul>
            {airport.pros.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        </div>
        <div class="cons-box">
          <div class="box-head text-yellow">⚠️ 注意事项与潜在限制</div>
          <ul>
            {airport.cons.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Section 6: Target Audience -->
    <section class="content-section">
      <h2>{airport.unlockImgs && airport.unlockImgs.length > 0 ? "七" : "六"}、人群匹配：适合你吗？</h2>
      <div class="audience-grid">
        <div class="aud-card fit">
          <h4>🎯 极度推荐选购的人群</h4>
          <p>{airport.bestFor}</p>
          <ul>
            <li>需要全天候稳定进行学术查重、海外期刊下载的研究人员；</li>
            <li>重度依赖 ChatGPT、Claude 进行写代码、撰写外贸邮件的从业者；</li>
            <li>追求 YouTube 4K/8K 与 Netflix 高画质无缓冲观影的追剧党。</li>
          </ul>
        </div>
        <div class="aud-card unfit">
          <h4>🚫 不建议选购的人群</h4>
          <ul>
            <li>仅希望一次性白嫖免费试用、不愿支付任何基础月费的用户；</li>
            <li>从事极端违规大流量攻击行为（各正规机场均配备风控探针）；</li>
            <li>无法接受非退款政策的超高频换梯试用党。</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Section 7: FAQs -->
    <section class="content-section">
      <h2>{airport.unlockImgs && airport.unlockImgs.length > 0 ? "八" : "七"}、关于 {airport.name} 的常见疑问 (FAQ)</h2>
      <div class="faq-accordion">
        {faqList.map((item, idx) => (
          <details class="faq-item" open={idx === 0}>
            <summary class="faq-question">
              <span>{item.q}</span>
              <span class="faq-icon">▾</span>
            </summary>
            <div class="faq-answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Section 8: Related Airports Internal Linking -->
    <section class="content-section">
      <h2>{airport.unlockImgs && airport.unlockImgs.length > 0 ? "九" : "八"}、同梯队备选与横向对比推荐</h2>
      <p>为防止单家机场突发不可抗力维护，建议同步配置一家备用梯子：</p>
      <div class="related-grid">
        {relatedAirports.map((rel) => (
          <div class="related-card">
            <span class="rel-rank">#{rel.rank}</span>
            <div class="rel-info">
              <a href={`/reviews/${rel.slug}`} class="rel-name"><strong>{rel.name}</strong></a>
              <span class="rel-price">{rel.startingPrice}</span>
              <p class="rel-tag">{rel.tagline}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Bottom CTA Bar -->
    <footer class="review-bottom-cta">
      <div class="bottom-cta-inner">
        <div>
          <h3>准备开始使用 {airport.name} 了吗？</h3>
          <p>官方直达通道已包含专属防护，结账时输入特惠折扣码 <strong>{airport.promoCode || "立享优惠"}</strong></p>
        </div>
        <a
          href={airport.affLink}
          target="_blank"
          rel="nofollow sponsored noopener"
          class="bottom-btn"
        >
          🚀 立即前往 {airport.name} 官网注册
        </a>
      </div>
    </footer>
  </article>
</Layout>

<style>
  .review-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    max-width: 900px;
    margin: 0 auto;
  }

  .review-header {
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-s);
  }

  .header-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--space-xs);
  }

  .rank-badge {
    background: var(--foreground);
    color: var(--background);
    padding: 2px 10px;
    border-radius: var(--radius-full);
    font-size: var(--step--1);
    font-weight: 800;
  }

  .feat-badge {
    background: #00e676;
    color: #0c1a12;
    padding: 2px 10px;
    border-radius: var(--radius-full);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .top-badge {
    background: #0284c7;
    color: #fff;
    padding: 2px 10px;
    border-radius: var(--radius-full);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .norm-badge {
    background: color-mix(in oklab, var(--muted) 60%, transparent);
    color: var(--muted-foreground);
    padding: 2px 10px;
    border-radius: var(--radius-full);
    font-size: var(--step--1);
  }

  .date-badge {
    color: var(--muted-foreground);
    font-size: var(--step--2);
    margin-left: auto;
  }

  .review-title {
    font-size: var(--step-2);
    font-weight: 800;
    margin: 0 0 8px;
    line-height: 1.25;
  }

  .review-subtitle {
    font-size: var(--step-0);
    color: var(--muted-foreground);
    margin: 0 0 var(--space-s);
    line-height: 1.5;
  }

  .geo-summary-box {
    background: color-mix(in oklab, #0284c7 10%, var(--background));
    border: 1px solid color-mix(in oklab, #0284c7 35%, var(--border));
    border-radius: var(--radius-lg);
    padding: var(--space-s);
    margin-bottom: var(--space-s);
  }

  .summary-label {
    font-size: var(--step--1);
    font-weight: 700;
    color: #0284c7;
    margin-bottom: 6px;
  }

  .summary-text {
    font-size: var(--step-0);
    line-height: 1.6;
    margin: 0 0 8px;
  }

  .summary-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    font-size: var(--step--2);
    color: var(--muted-foreground);
    border-top: 1px dashed color-mix(in oklab, #0284c7 30%, transparent);
    padding-top: 6px;
  }

  .header-cta-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: color-mix(in oklab, var(--muted) 25%, var(--background));
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-xs) var(--space-s);
  }

  .price-info {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .price-val {
    font-size: var(--step-1);
    font-weight: 800;
    color: var(--accent);
  }

  .code-pill {
    background: color-mix(in oklab, #ffab00 15%, transparent);
    border: 1px solid color-mix(in oklab, #ffab00 40%, transparent);
    padding: 2px 8px;
    border-radius: 4px;
    font-size: var(--step--2);
  }
  .code-pill code {
    color: #ffab00;
    font-weight: 800;
  }

  .header-btn {
    background: var(--accent);
    color: var(--accent-foreground, #fff);
    padding: 8px 18px;
    border-radius: var(--radius-md);
    font-weight: 700;
    font-size: var(--step--1);
    text-decoration: none;
    transition: opacity var(--motion-duration-fast) var(--motion-ease);
  }
  .header-btn:hover {
    opacity: 0.9;
  }

  .content-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .content-section h2 {
    font-size: var(--step-1);
    font-weight: 700;
    margin: var(--space-xs) 0 4px;
    border-left: 4px solid var(--accent);
    padding-left: 10px;
  }

  .content-section p {
    font-size: var(--step-0);
    color: var(--foreground);
    line-height: 1.7;
    margin: 0;
  }

  .specs-table-wrapper {
    overflow-x: auto;
    margin-block: var(--space-xs);
  }

  .specs-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .specs-table th, .specs-table td {
    padding: 10px 14px;
    border: 1px solid var(--border);
    text-align: left;
  }

  .specs-table th {
