---
import type { AirportBrand } from "@/data/airports"

interface Props {
  airport: AirportBrand
  showDetails?: boolean
}

const { airport, showDetails = true } = Astro.props
---

<div class:list={["airport-card", { "is-featured": airport.isFeatured, "is-top10": airport.isTop10 }]}>
  <div class="card-badge-row">
    <div class="rank-badge">
      <span class="rank-num">#{airport.rank}</span>
      {airport.isFeatured ? (
        <span class="flag-badge featured">⭐ 2026年度主推旗舰</span>
      ) : airport.isTop10 ? (
        <span class="flag-badge top10">🏆 TOP 10 精选推荐</span>
      ) : (
        <span class="flag-badge">稳定优选</span>
      )}
    </div>
    <div class="price-badge">
      <span class="price-text">{airport.startingPrice}</span>
    </div>
  </div>

  <div class="card-header">
    <div class="brand-info">
      <h3 class="brand-name">
        <a href={`/reviews/${airport.slug}`} class="brand-link">
          {airport.name}
        </a>
      </h3>
      <p class="brand-tagline">{airport.tagline}</p>
    </div>
  </div>

  <div class="tags-row">
    {airport.lines.map((line) => (
      <span class="line-tag">⚡ {line}</span>
    ))}
    {airport.protocols.map((proto) => (
      <span class="proto-tag">🛡️ {proto}</span>
    ))}
  </div>

  <div class="card-benchmarks">
    <div class="bench-item">
      <span class="bench-label">测速峰值</span>
      <span class="bench-val text-green">
        {airport.speedRecords[0] ? airport.speedRecords[0].speed : "529Mbps"}
      </span>
    </div>
    <div class="bench-item">
      <span class="bench-label">晚高峰延迟</span>
      <span class="bench-val text-blue">
        ~{airport.speedRecords[0] ? airport.speedRecords[0].latency : "25ms"}
      </span>
    </div>
    <div class="bench-item">
      <span class="bench-label">丢包率</span>
      <span class="bench-val text-purple">0.0% 专线</span>
    </div>
  </div>

  <div class="unlock-chips">
    <span class="chips-title">实测解锁：</span>
    {airport.unlock.slice(0, 5).map((u) => (
      <span class="chip-item">✅ {u}</span>
    ))}
  </div>

  {airport.promoCode ? (
    <div class="promo-box">
      <div class="promo-left">
        <span class="promo-label">专属优惠码</span>
        <code class="promo-code">{airport.promoCode}</code>
      </div>
      <span class="promo-hint">(结账立享折扣)</span>
    </div>
  ) : (
    <div class="promo-placeholder" aria-hidden="true"></div>
  )}

  <div class="card-actions">
    <a
      href={airport.affLink}
      target="_blank"
      rel="nofollow sponsored noopener"
      class="cta-btn primary"
    >
      🚀 直达官网注册
    </a>
    {showDetails && (
      <a href={`/reviews/${airport.slug}`} class="cta-btn secondary">
        📊 详细评测报告
      </a>
    )}
  </div>
</div>

<style>
  .airport-card {
    background: color-mix(in oklab, var(--muted) 15%, var(--background));
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: var(--space-s);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    position: relative;
    height: 100%;
    transition: transform var(--motion-duration) var(--motion-ease),
                box-shadow var(--motion-duration) var(--motion-ease),
                border-color var(--motion-duration) var(--motion-ease);
  }

  .airport-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
  }

  .airport-card.is-featured {
    border: 2px solid #00e676;
    background: linear-gradient(
      145deg,
      color-mix(in oklab, #00e676 7%, var(--background)),
      var(--background) 70%
    );
    box-shadow: 0 10px 30px rgba(0, 230, 118, 0.12);
  }

  .airport-card.is-top10:not(.is-featured) {
    border-color: color-mix(in oklab, #0284c7 40%, var(--border));
  }

  .card-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .rank-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .rank-num {
    font-size: var(--step-0);
    font-weight: 800;
    color: var(--foreground);
    line-height: 1;
  }

  .flag-badge {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: var(--radius-full);
    background: color-mix(in oklab, var(--muted) 60%, transparent);
    color: var(--muted-foreground);
    white-space: nowrap;
  }

  .flag-badge.featured {
    background: #00e676;
    color: #0b1a12;
    font-weight: 700;
  }

  .flag-badge.top10 {
    background: #0284c7;
    color: #ffffff;
  }

  .price-badge {
    flex-shrink: 0;
  }

  .price-text {
    font-weight: 700;
    color: var(--accent);
    font-size: var(--step-0);
    white-space: nowrap;
  }

  .card-header {
    margin-top: -2px;
  }

  .brand-name {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
  }

  .brand-link {
    color: inherit;
    text-decoration: none;
  }
  .brand-link:hover {
    color: var(--accent);
  }

  .brand-tagline {
    margin: 3px 0 0;
    font-size: 0.82rem;
    color: var(--muted-foreground);
    line-height: 1.4;
    min-height: 2.4em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .line-tag, .proto-tag {
    font-size: 0.72rem;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    background: var(--background);
    border: 1px solid var(--border);
    white-space: nowrap;
  }

  .line-tag {
    color: #0284c7;
    border-color: color-mix(in oklab, #0284c7 30%, var(--border));
    font-weight: 500;
  }

  .proto-tag {
    color: var(--muted-foreground);
  }

  .card-benchmarks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 8px 6px;
    text-align: center;
  }

  .bench-label {
    display: block;
    font-size: 0.72rem;
    color: var(--muted-foreground);
    margin-bottom: 2px;
  }

  .bench-val {
    font-size: 0.88rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .text-green { color: #00c853; }
  .text-blue { color: #0284c7; }
  .text-purple { color: #8b5cf6; }

  .unlock-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    color: var(--muted-foreground);
    line-height: 1.5;
  }

  .chips-title {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--foreground);
    white-space: nowrap;
  }

  .chip-item {
    font-size: 0.72rem;
    background: color-mix(in oklab, var(--muted) 45%, transparent);
    padding: 1px 5px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .promo-box {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    background: color-mix(in oklab, #ffab00 12%, var(--background));
    border: 1px dashed color-mix(in oklab, #ffab00 45%, transparent);
    border-radius: var(--radius-md);
  }

  .promo-left {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .promo-label {
    font-size: 0.75rem;
    color: var(--muted-foreground);
    white-space: nowrap;
  }

  .promo-code {
    background: #ffab00;
    color: #1a1000;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 800;
    font-family: monospace;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    user-select: all;
    white-space: nowrap;
  }

  .promo-hint {
    font-size: 0.72rem;
    color: var(--muted-foreground);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .promo-placeholder {
    height: 32px;
  }

  .card-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: auto;
    padding-top: 4px;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 8px;
    border-radius: var(--radius-md);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: all var(--motion-duration-fast) var(--motion-ease);
  }

  .cta-btn.primary {
    background: var(--accent);
    color: var(--accent-foreground, #ffffff);
  }
  .cta-btn.primary:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  .cta-btn.secondary {
    background: var(--background);
    border: 1px solid var(--border);
    color: var(--foreground);
  }
  .cta-btn.secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 500px) {
    .card-actions {
      grid-template-columns: 1fr;
    }
  }
</style>
