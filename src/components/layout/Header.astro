---
import { NAV_LINKS, SITE } from "@site-config"
import Link from "@/components/base/Link.astro"
import MobileMenu from "@/components/layout/MobileMenu.astro"
import ThemeToggle from "@/components/layout/ThemeToggle.astro"
---

<header class="site-header">
  <div class="site-brand">
    <Link href="/" class="site-title" transition:persist>
      <span class="site-logo">✈️</span>
      <span class="site-title-text">{SITE.title}</span>
    </Link>
  </div>
  <div class="site-actions">
    <nav class="desktop-nav" aria-label="Site navigation">
      {NAV_LINKS.map((item) => {
        const isActive =
          Astro.url.pathname === item.href ||
          (item.href !== "/" && Astro.url.pathname.startsWith(item.href))
        return (
          <Link
            href={item.href}
            class:list={["nav-link", isActive && "nav-active"]}
          >
            {item.label}
          </Link>
        )
      })}
    </nav>
    <MobileMenu transition:persist />
    <div class="desktop-theme">
      <ThemeToggle transition:persist />
    </div>
  </div>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    min-height: var(--control-size);
    padding-block: var(--space-3xs);
    width: 100%;
  }

  .site-brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .site-title {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    color: var(--foreground);
    font-size: 1.15rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition: color var(--motion-duration-fast) var(--motion-ease);
  }

  .site-logo {
    font-size: 1.25rem;
    line-height: 1;
  }

  .site-title:hover {
    color: var(--primary);
  }

  .site-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .desktop-nav {
    display: none;
    align-items: center;
    gap: 2px;
    font-size: 0.84rem;
    flex-wrap: nowrap !important;
    white-space: nowrap !important;
    flex-shrink: 0;

    @media (width >= 40rem) {
      display: flex;
    }
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding-inline: 8px;
    white-space: nowrap !important;
    word-break: keep-all !important;
    flex-shrink: 0 !important;
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color var(--motion-duration-fast) var(--motion-ease);
  }

  .nav-link:hover {
    color: var(--accent);
  }

  .nav-active {
    color: var(--foreground);
    font-weight: var(--font-weight-semibold);
  }

  .nav-active::after {
    content: "";
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 50%;
    transform: translateX(-50%);
    inline-size: 16px;
    block-size: 2px;
    border-radius: var(--radius-full);
    background: var(--primary);
    opacity: 0.9;
    transition:
      opacity var(--motion-duration) var(--motion-ease),
      transform var(--motion-duration) var(--motion-ease);
  }

  .nav-active:hover::after {
    opacity: 1;
    transform: translateX(-50%) scale(1.25);
  }

  .desktop-theme {
    display: none;
    flex-shrink: 0;

    @media (width >= 40rem) {
      display: flex;
    }
  }
</style>
